# HostGator (Apache): as mesmas regras do netlify.toml.

# HTTPS forçado aqui, porque o botão do cPanel fica bloqueado (www.sonia não tem certificado).
# A pasta .well-known fica de fora para não atrapalhar a renovação do certificado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

Options -Indexes
DirectoryIndex index.html

AddType video/mp4 .mp4
AddType video/webm .webm
AddType text/vtt .vtt
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/json .json
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "editor.html">
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
  <Files "conteudo.json">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
